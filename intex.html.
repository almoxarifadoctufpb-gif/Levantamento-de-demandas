        .titulo{font-size:14pt;font-weight:bold;color:#0b3d6b}
        .subtitulo{font-size:10pt;color:#5a6577}
        .secao{font-size:11pt;font-weight:bold;background:#e8f1f9;color:#0b3d6b}
        .total{font-weight:bold;background:#e8f1f9}
        .num{text-align:right}
        .id{font-weight:bold;color:#0b3d6b;font-size:12pt}
      </style></head><body><table>`;

    todasLinhas.forEach((linha, idx) => {
      if (idx === 0) {
        html += `<tr><td colspan="5" class="titulo">${_esc(linha[0])}</td></tr>`;
        return;
      }
      if (idx === 1) {
        html += `<tr><td colspan="5" class="subtitulo">${_esc(linha[0])}</td></tr>`;
        return;
      }
      if (idx === 16) {
        html += `<tr><td colspan="5" class="secao">${_esc(linha[0])}</td></tr>`;
        return;
      }
      if (idx === 17) {
        html += `<tr>${linha.map(c => `<th>${_esc(c)}</th>`).join("")}</tr>`;
        return;
      }
      if (!linha.length || linha.every(c => c === "" || c === undefined)) {
        html += `<tr><td colspan="5" style="border:none">&nbsp;</td></tr>`;
        return;
      }
      if (linha[0] === "" && linha[3] === "TOTAL DE UNIDADES") {
        html += `<tr><td class="total"></td><td class="total"></td><td class="total"></td><td class="total" style="text-align:right">${_esc(linha[3])}</td><td class="total num">${linha[4]}</td></tr>`;
        return;
      }
      if (linha.length === 1) {
        html += `<tr><td colspan="5" style="border:none;font-size:9pt;color:#5a6577">${_esc(linha[0])}</td></tr>`;
        return;
      }
      if (idx >= 3 && idx <= 14) {
        html += `<tr><td style="background:#f4f6f9;font-weight:bold;width:180px">${_esc(linha[0])}</td><td colspan="4">${_esc(linha[1])}</td></tr>`;
        return;
      }
      html += `<tr>${linha.map((c, ci) => {
        const val = c === undefined || c === null ? "" : c;
        const cls = (ci >= 3) ? ' class="num"' : "";
        return `<td${cls}>${_esc(val)}</td>`;
      }).join("")}</tr>`;
    });

    html += `</table></body></html>`;

    function _esc(s) {
      return String(s).replace(/[&<>"']/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;" }[c]));
    }

    const blob = new Blob(["\uFEFF" + html], { type: "application/vnd.ms-excel;charset=utf-8" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `copia_demanda_${(d.id_demanda || "sem-id").replace(/[^a-zA-Z0-9\-]/g, "_")}.xls`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);

    Util.toast("📊 Planilha gerada e baixada com sucesso.", "ok");
  }

  return { baixarPDF, baixarXLSX };
})();

/* ============================================================
   MÓDULO RASCUNHOS
   ============================================================ */
const Rascunhos = (() => {
  const STORAGE_KEY = "ct_rascunhos_local";
  let _editandoId = null;

  function _gerarId() {
    const ano = new Date().getFullYear();
    let seq = 1;
    try {
      const lista = listar();
      const idsAno = lista.map(r => r.id).filter(id => id && id.startsWith(`RASC-${ano}-`));
      if (idsAno.length) {
        const nums = idsAno.map(id => parseInt(id.split("-")[2], 10)).filter(n => !isNaN(n));
        seq = (nums.length ? Math.max(...nums) : 0) + 1;
      }
    } catch(e) { seq = 1; }
    return `RASC-${ano}-${String(seq).padStart(4, "0")}`;
  }

  function listar() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]"); }
    catch(e) { return []; }
  }

  function _persistir(lista) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(lista)); }
    catch(e) { Util.toast("Erro ao salvar rascunho no dispositivo.", "erro"); }
  }

  function salvar() {
    Demanda.coletarDadosFormulario();
    const d = State.dados;
    const temConteudo = d.departamento || d.setor || d.semestre || d.responsavel ||
                       d.chefia || d.telefone || d.email || d.matricula || d.observacao ||
                       State.carrinho.length > 0;
    if (!temConteudo) {
      Util.toast("Preencha ao menos um campo antes de gravar o pedido.", "erro");
      return;
    }
    const lista = listar();
    const agora = Util.agora();
    if (_editandoId) {
      const idx = lista.findIndex(r => r.id === _editandoId);
      if (idx >= 0) {
        lista[idx] = {
          ...lista[idx],
          dados: { ...d },
          carrinho: State.carrinho.map(i => ({ ...i })),
          etapaAtual: State.etapaAtual,
          atualizadoEm: agora
        };
        _persistir(lista);
        Util.toast("✓ Pedido atualizado com sucesso.", "ok");
        _mostrarIndicadorSalvo();
        MeusPedidos.render();
        return _editandoId;
      }
    }
    const id = _gerarId();
    const novo = {
      id, criadoEm: agora, atualizadoEm: agora,
      etapaAtual: State.etapaAtual,
      dados: { ...d },
      carrinho: State.carrinho.map(i => ({ ...i }))
    };
    lista.push(novo);
    _persistir(lista);
    _editandoId = id;
    State.rascunhoIdAtual = id;
    _mostrarIndicadorEdicao(id);
    Util.toast(`✓ Pedido ${id} salvo com sucesso.`, "ok");
    _mostrarIndicadorSalvo();
    MeusPedidos.render();
    return id;
  }

  function salvarManual() { salvar(); }

  function carregar(id) {
    const lista = listar();
    const r = lista.find(x => x.id === id);
    if (!r) { Util.toast("Rascunho não encontrado.", "erro"); return false; }
    _editandoId = id;
    State.rascunhoIdAtual = id;
    State.dados = { ...r.dados };
    State.carrinho = (r.carrinho || []).map(i => ({ ...i }));
    State.etapaAtual = r.etapaAtual || 1;
    _preencherFormulario(r.dados);
    App.setEtapa(State.etapaAtual);
    Demanda.renderCarrinho();
    _mostrarIndicadorEdicao(id);
    App.go("demanda");
    Util.toast(`Rascunho ${id} restaurado. Continue de onde parou.`, "ok");
    return true;
  }

  function _preencherFormulario(d) {
    const set = (id, val) => { const el = document.getElementById(id); if (el) el.value = val || ""; };
    set("sel-departamento", d.departamento);
    set("inp-setor-manual", d.setor);
    set("sel-semestre", d.semestre);
    set("inp-responsavel", d.responsavel);
    set("inp-chefia", d.chefia);
    set("inp-telefone", d.telefone);
    set("inp-email", d.email);
    set("inp-matricula", d.matricula);
    set("inp-observacao", d.observacao);
    const chk = document.getElementById("chk-mesma-pessoa");
    if (chk) chk.checked = !!(d.responsavel && d.chefia && d.responsavel === d.chefia);
  }

  function excluir(id) {
    Modal.confirmar(
      "Excluir pedido salvo",
      "Deseja realmente excluir este pedido salvo? Esta ação não poderá ser desfeita.",
      () => {
        const lista = listar().filter(r => r.id !== id);
        _persistir(lista);
        if (_editandoId === id) {
          _editandoId = null;
          State.rascunhoIdAtual = null;
          _esconderIndicadores();
        }
        Util.toast("🗑️ Pedido excluído.", "ok");
        MeusPedidos.render();
      }
    );
  }

  function _mostrarIndicadorEdicao(id) {
    const el = document.getElementById("rascunho-indicator");
    const label = document.getElementById("rascunho-id-label");
    if (el && label) { label.textContent = id; el.style.display = "block"; }
  }

  function _esconderIndicadores() {
    const el = document.getElementById("rascunho-indicator");
    if (el) el.style.display = "none";
  }

  function _mostrarIndicadorSalvo() {
    let ind = document.getElementById("salvo-indicator");
    if (!ind) {
      ind = document.createElement("div");
      ind.id = "salvo-indicator";
      ind.className = "salvo-indicator";
      ind.innerHTML = '<svg class="ico-svg sm"><use href="#i-check"/></svg> Pedido salvo';
      const header = document.querySelector(".topbar-inner");
      if (header) header.appendChild(ind);
    }
    ind.classList.add("show");
    clearTimeout(ind._t);
    ind._t = setTimeout(() => ind.classList.remove("show"), 2500);
  }

  function descartarEdicao() {
    if (!_editandoId) return;
    Modal.confirmar(
      "Descartar rascunho",
      "Deseja descartar este rascunho? O pedido em edição será excluído.",
      () => {
        excluir(_editandoId);
        App.novoPedido();
      }
    );
  }

  function limparEdicaoAtual() {
    _editandoId = null;
    State.rascunhoIdAtual = null;
    _esconderIndicadores();
  }

  function getEditandoId() { return _editandoId; }

  let _autosaveTimer = null;
  function autosave() {
    clearTimeout(_autosaveTimer);
    _autosaveTimer = setTimeout(() => {
      if (State.etapaAtual >= 6) return;
      const d = State.dados;
      const temConteudo = d.departamento || d.setor || d.responsavel || d.telefone || d.email || State.carrinho.length > 0;
      if (!temConteudo) return;
      if (_editandoId) {
        const lista = listar();
        const idx = lista.findIndex(r => r.id === _editandoId);
        if (idx >= 0) {
          Demanda.coletarDadosFormulario();
          lista[idx].dados = { ...State.dados };
          lista[idx].carrinho = State.carrinho.map(i => ({ ...i }));
          lista[idx].etapaAtual = State.etapaAtual;
          lista[idx].atualizadoEm = Util.agora();
          _persistir(lista);
        }
      }
    }, 3000);
  }

  return {
    salvar, salvarManual, listar, carregar, excluir,
    descartarEdicao, limparEdicaoAtual, getEditandoId, autosave
  };
})();


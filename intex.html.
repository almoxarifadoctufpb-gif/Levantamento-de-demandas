/* ============================================================
   MÓDULO MODAL DE CONFIRMAÇÃO
   ============================================================ */
const Modal = (() => {
  let _callback = null;

  function confirmar(titulo, msg, cb) {
    document.getElementById("modal-title").textContent = titulo;
    document.getElementById("modal-msg").textContent = msg;
    _callback = cb;
    document.getElementById("modal-confirm").classList.add("show");
    document.getElementById("modal-btn-confirmar").focus();
  }

  function fechar() {
    document.getElementById("modal-confirm").classList.remove("show");
    _callback = null;
  }

  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("modal-btn-confirmar");
    if (btn) {
      btn.addEventListener("click", () => {
        const cb = _callback;
        fechar();
        if (cb) cb();
      });
    }
  });

  document.addEventListener("keydown", e => {
    if (e.key === "Escape" && document.getElementById("modal-confirm").classList.contains("show")) {
      fechar();
    }
  });

  return { confirmar, fechar };
})();

/* ============================================================
   MÓDULO ORIENTAÇÃO DO SETOR
   ============================================================ */
const OrientacaoSetor = (() => {
  const STORAGE_KEY = "ct_orientacao_setor_vista";

  function deveExibir() {
    try { return sessionStorage.getItem(STORAGE_KEY) !== "1"; }
    catch(e) { return true; }
  }

  function marcarComoVista() {
    try { sessionStorage.setItem(STORAGE_KEY, "1"); }
    catch(e) {}
  }

  function exibir(callback) {
    const overlay = document.getElementById("modal-orientacao-setor");
    const btn = document.getElementById("btn-entendi-setor");

    function fechar() {
      overlay.classList.remove("show");
      marcarComoVista();
      btn.removeEventListener("click", fechar);
      if (callback) callback();
    }

    btn.addEventListener("click", fechar, { once: true });
    overlay.classList.add("show");
  }

  return { deveExibir, marcarComoVista, exibir };
})();

/* ============================================================
   STATE
   ============================================================ */
const State = {
  dados: {
    departamento: "", setor: "", semestre: "",
    responsavel: "", chefia: "", telefone: "", email: "",
    matricula: "", observacao: ""
  },
  carrinho: [],
  etapaAtual: 1,
  ultimaDemanda: null,
  rascunhoIdAtual: null,

  reset() {
    this.dados = { departamento:"", setor:"", semestre:"", responsavel:"", chefia:"",
                   telefone:"", email:"", matricula:"", observacao:"" };
    this.carrinho = [];
    this.etapaAtual = 1;
    this.ultimaDemanda = null;
    this.rascunhoIdAtual = null;
  },
  addItem(mat) {
    if (this.carrinho.find(i => i.codigo === mat.codigo)) return { duplicado: true };
    this.carrinho.push({ ...mat, qtd: mat.qtd });
    return { duplicado: false };
  },
  removeItem(codigo) { this.carrinho = this.carrinho.filter(i => i.codigo !== codigo); },
  updateQtd(codigo, qtd) {
    const it = this.carrinho.find(i => i.codigo === codigo);
    if (it) it.qtd = Math.max(1, Number(qtd) || 1);
  },
  totalItens() { return this.carrinho.length; },
  totalUnidades() { return this.carrinho.reduce((s, i) => s + i.qtd, 0); }
};

/* ============================================================
   UTIL
   ============================================================ */
const Util = (() => {
  function toast(msg, tipo = "info") {
    const el = document.getElementById("toast");
    el.innerHTML = (tipo === "ok" ? '<svg class="ico-svg sm"><use href="#i-check-circle"/></svg>' :
                    tipo === "erro" ? '<svg class="ico-svg sm"><use href="#i-alert"/></svg>' :
                    '<svg class="ico-svg sm"><use href="#i-info"/></svg>') + '<span>' + msg + '</span>';
    el.className = "toast show " + (tipo === "erro" ? "erro" : tipo === "ok" ? "ok" : "");
    clearTimeout(el._t);
    el._t = setTimeout(() => el.className = "toast", 3800);
  }
  function esc(s) {
    return String(s ?? "").replace(/[&<>"']/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;" }[c]));
  }
  function fmtNum(n) {
    const v = Number(n) || 0;
    return v.toLocaleString("pt-BR", { maximumFractionDigits: 2 });
  }
  function agora() {
    const d = new Date();
    return d.toLocaleString("pt-BR", { dateStyle:"short", timeStyle:"short" });
  }
  function gerarIdDemanda(semestre, seq) {
    const ano = (semestre || "").split(".")[0] || new Date().getFullYear();
    return `DEM-${ano}-${String(seq).padStart(5, "0")}`;
  }
  function validarEmail(e) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(e||"").trim()); }
  function mascaraTelefone(v) {
    v = String(v||"").replace(/\D/g,"").slice(0,11);
    if (v.length <= 10) return v.replace(/(\d{0,2})(\d{0,4})(\d{0,4}).*/, (_,a,b,c)=> a ? `(${a})${b?" "+b:""}${c?"-"+c:""}` : "");
    return v.replace(/(\d{2})(\d{5})(\d{0,4}).*/, "($1) $2-$3");
  }
  function semestresDisponiveis() {
    const anoAtual = new Date().getFullYear();
    const out = [];
    for (let a = anoAtual - 1; a <= anoAtual + 2; a++) {
      out.push(`${a}.1`); out.push(`${a}.2`);
    }
    return out;
  }
  return { toast, esc, fmtNum, agora, gerarIdDemanda, validarEmail, mascaraTelefone, semestresDisponiveis };
})();

/* ============================================================
   DEMANDA
   ============================================================ */
const Demanda = (() => {

  let _orientacaoJaExibidaNoCampo = false;

  async function init() {
    const selDep = document.getElementById("sel-departamento");
    API.getDepartamentos().forEach(d => {
      const o = document.createElement("option");
      o.value = d; o.textContent = d;
      selDep.appendChild(o);
    });

    const selSem = document.getElementById("sel-semestre");
    Util.semestresDisponiveis().forEach(s => {
      const o = document.createElement("option");
      o.value = s; o.textContent = s;
      selSem.appendChild(o);
    });
    const hoje = new Date();
    const semAtual = `${hoje.getFullYear()}.${hoje.getMonth() < 6 ? 1 : 2}`;
    selSem.value = semAtual;
    State.dados.semestre = semAtual;

    const materiais = await API.carregarMateriais();
    const grupos = [...new Map(materiais.map(m => [m.grupo, m])).values()]
      .sort((a,b) => a.grupo.localeCompare(b.grupo));
    const selGrupo = document.getElementById("sel-grupo");
    grupos.forEach(g => {
      const o = document.createElement("option");
      o.value = g.grupo;
      o.textContent = `${g.grupo} — ${g.descGrupo}`;
      selGrupo.appendChild(o);
    });

    bindEventos();
    console.info(`[Demanda] Materiais carregados via ${API.getFonte()}.`);
    if (API.getFonte() === "fallback") {
      Util.toast("API indisponível — usando base local de materiais.", "erro");
    } else {
      Util.toast("API conectada com sucesso!", "ok");
    }
  }

  function bindEventos() {
    document.getElementById("sel-departamento").addEventListener("change", e => {
      State.dados.departamento = e.target.value;
      Rascunhos.autosave();
    });

    const inpSetor = document.getElementById("inp-setor-manual");

    inpSetor.addEventListener("focus", () => {
      if (!_orientacaoJaExibidaNoCampo && OrientacaoSetor.deveExibir()) {
        _orientacaoJaExibidaNoCampo = true;
        inpSetor.blur();
        setTimeout(() => {
          OrientacaoSetor.exibir(() => {
            inpSetor.focus();
          });
        }, 60);
        return;
      }
    });

    inpSetor.addEventListener("input", e => {
      State.dados.setor = e.target.value;
      Rascunhos.autosave();
    });

    document.getElementById("sel-semestre").addEventListener("change", e => {
      State.dados.semestre = e.target.value;
      Rascunhos.autosave();
    });

    document.getElementById("chk-mesma-pessoa").addEventListener("change", e => {
      if (e.target.checked) {
        document.getElementById("inp-chefia").value = document.getElementById("inp-responsavel").value;
        State.dados.chefia = State.dados.responsavel;
      }
    });
    document.getElementById("inp-responsavel").addEventListener("input", e => {
      State.dados.responsavel = e.target.value;
      if (document.getElementById("chk-mesma-pessoa").checked) {
        document.getElementById("inp-chefia").value = e.target.value;
        State.dados.chefia = e.target.value;
      }
      Rascunhos.autosave();
    });
    document.getElementById("inp-chefia").addEventListener("input", e => {
      State.dados.chefia = e.target.value;
      Rascunhos.autosave();
    });

    document.getElementById("inp-telefone").addEventListener("input", e => {
      e.target.value = Util.mascaraTelefone(e.target.value);
      State.dados.telefone = e.target.value;
      Rascunhos.autosave();
    });
    document.getElementById("inp-email").addEventListener("input", e => {
      State.dados.email = e.target.value;
      Rascunhos.autosave();
    });
    document.getElementById("inp-matricula").addEventListener("input", e => {
      State.dados.matricula = e.target.value;
      Rascunhos.autosave();
    });
    document.getElementById("inp-observacao").addEventListener("input", e => {
      State.dados.observacao = e.target.value;
      Rascunhos.autosave();
    });

    document.getElementById("sel-grupo").addEventListener("change", async e => {
      const g = e.target.value;
      const cont = document.getElementById("lista-materiais");
      if (!g) {
        cont.innerHTML = '<div class="empty"><svg class="ico-svg xxl"><use href="#i-clipboard"/></svg><div>Selecione um grupo acima para visualizar os materiais.</div></div>';
        return;
      }
      const materiais = await API.carregarMateriais();
      const lista = materiais.filter(m => m.grupo === g);
      cont.innerHTML = "";
      if (!lista.length) {
        cont.innerHTML = '<div class="empty">Nenhum material neste grupo.</div>';
        return;
      }
      lista.forEach(m => {
        const div = document.createElement("div");
        div.className = "material-row";
        div.innerHTML = `
          <div class="material-info">
            <div class="nome" title="${Util.esc(m.material)}">${Util.esc(m.material)}</div>
            <div class="meta">Código: <b>${Util.esc(m.codigo)}</b> · Saldo atual: <b>${Util.fmtNum(m.saldo)}</b></div>
          </div>
          <div class="material-add">
            <input type="number" min="1" value="1" class="qtd-input" data-cod="${Util.esc(m.codigo)}" />
            <button class="btn btn-primary btn-sm" data-add="${Util.esc(m.codigo)}">
              <svg class="ico-svg sm"><use href="#i-plus"/></svg> Adicionar
            </button>
          </div>`;
        cont.appendChild(div);
      });
      cont.querySelectorAll("[data-add]").forEach(btn => {
        btn.addEventListener("click", () => {
          const cod = btn.getAttribute("data-add");
          const mat = lista.find(x => x.codigo === cod);
          const qtdInput = cont.querySelector(`.qtd-input[data-cod="${CSS.escape(cod)}"]`);
          const qtd = Math.max(1, Number(qtdInput.value) || 1);
          const r = State.addItem({ ...mat, qtd });
          if (r.duplicado) { Util.toast("Este material já foi adicionado à sua demanda.", "erro"); return; }
          Util.toast(`Adicionado: ${mat.material.slice(0,40)}...`, "ok");
          renderCarrinho();
          Rascunhos.autosave();
        });
      });
    });
  }

  function renderCarrinho() {
    const cont = document.getElementById("cart-items");
    if (!State.carrinho.length) {
      cont.innerHTML = '<div class="empty" style="padding:18px"><svg class="ico-svg xl"><use href="#i-clipboard"/></svg><div>Nenhum material adicionado ainda.</div></div>';
    } else {
      cont.innerHTML = "";
      State.carrinho.forEach(it => {
        const div = document.createElement("div");
        div.className = "cart-item";
        div.innerHTML = `
          <div>
            <div class="ci-nome">${Util.esc(it.material.length > 70 ? it.material.slice(0,70)+"..." : it.material)}</div>
            <div class="ci-meta">Cód. ${Util.esc(it.codigo)} · ${Util.esc(it.descGrupo)}</div>
          </div>
          <input type="number" min="1" value="${it.qtd}" data-qtd="${Util.esc(it.codigo)}" />
          <button class="btn-remove" data-rm="${Util.esc(it.codigo)}" title="Remover">
            <svg class="ico-svg sm"><use href="#i-trash"/></svg>
          </button>`;
        cont.appendChild(div);
      });
      cont.querySelectorAll("[data-qtd]").forEach(inp => {
        inp.addEventListener("change", e => {
          State.updateQtd(inp.getAttribute("data-qtd"), e.target.value);
          renderCarrinho();
          Rascunhos.autosave();
        });
      });
      cont.querySelectorAll("[data-rm]").forEach(btn => {
        btn.addEventListener("click", () => {
          State.removeItem(btn.getAttribute("data-rm"));
          renderCarrinho();
          Rascunhos.autosave();
        });
      });
    }
    document.getElementById("cart-count").textContent = State.totalItens();
    document.getElementById("cart-total").textContent = Util.fmtNum(State.totalUnidades());
  }

  function coletarDadosFormulario() {
    State.dados.departamento = document.getElementById("sel-departamento").value;
    State.dados.setor = document.getElementById("inp-setor-manual").value.trim();
    State.dados.semestre = document.getElementById("sel-semestre").value;
    State.dados.responsavel = document.getElementById("inp-responsavel").value.trim();
    State.dados.chefia = document.getElementById("inp-chefia").value.trim();
    State.dados.telefone = document.getElementById("inp-telefone").value.trim();
    State.dados.email = document.getElementById("inp-email").value.trim();
    State.dados.matricula = document.getElementById("inp-matricula").value.trim();
    State.dados.observacao = document.getElementById("inp-observacao").value.trim();
  }

  function validarEtapa(n) {
    coletarDadosFormulario();
    const erros = [];
    const d = State.dados;
    if (n >= 1) {
      if (!d.departamento) erros.push("Departamento é obrigatório.");
      if (!d.setor) erros.push("Setor demandante é obrigatório (informe por extenso).");
      if (!d.semestre) erros.push("Semestre da demanda é obrigatório.");
    }
    if (n >= 2) {
      if (!d.responsavel) erros.push("Responsável administrativo/técnico é obrigatório.");
      if (!d.chefia) erros.push("Chefia do setor é obrigatória.");
    }
    if (n >= 3) {
      if (!d.telefone) erros.push("WhatsApp/Telefone é obrigatório.");
      if (!d.email || !Util.validarEmail(d.email)) erros.push("E-mail válido é obrigatório.");
      if (!d.matricula) erros.push("Matrícula do responsável é obrigatória.");
    }
    if (n >= 4) {
      if (!State.carrinho.length) erros.push("Adicione pelo menos um material à demanda.");
      State.carrinho.forEach(i => { if (i.qtd <= 0) erros.push(`Quantidade inválida para ${i.material.slice(0,30)}...`); });
    }
    return erros;
  }

  function renderRevisao() {
    coletarDadosFormulario();
    const d = State.dados;
    document.getElementById("rev-dados").innerHTML = [
      ["Departamento", d.departamento],
      ["Setor", d.setor],
      ["Semestre", d.semestre],
      ["Responsável", d.responsavel],
      ["Chefia", d.chefia],
      ["Telefone", d.telefone],
      ["E-mail", d.email],
      ["Matrícula", d.matricula],
      ["Observação", d.observacao || "—"]
    ].map(([k,v]) => `<div class="revisao-item"><div class="k">${Util.esc(k)}</div><div class="v">${Util.esc(v)||"—"}</div></div>`).join("");

    const tbody = document.querySelector("#rev-tabela tbody");
    tbody.innerHTML = State.carrinho.map(i => `
      <tr>
        <td>${Util.esc(i.descGrupo)}</td>
        <td>${Util.esc(i.material)}</td>
        <td class="mono">${Util.esc(i.codigo)}</td>
        <td class="num">${Util.fmtNum(i.saldo)}</td>
        <td class="num"><b>${Util.fmtNum(i.qtd)}</b></td>
      </tr>`).join("");
  }

  return { init, renderCarrinho, coletarDadosFormulario, validarEtapa, renderRevisao };
})();

/* ============================================================
   ADMIN
   ============================================================ */
const Admin = (() => {
  let _todasDemandas = null;

  async function carregarDemandas() {
    _todasDemandas = await API.buscarDemandas();
  }

  async function render() {
    await carregarDemandas();
    const semFiltro = document.getElementById("adm-semestre").value;
    const depFiltro = document.getElementById("adm-departamento").value;
    const grupoFiltro = document.getElementById("adm-grupo").value;
    const busca = document.getElementById("adm-busca").value.trim().toLowerCase();

    const demandas = (_todasDemandas || []).map(normalizarDemanda).filter(d => d.itens && d.itens.length);

    const filtradas = demandas.filter(d => {
      if (semFiltro && d.semestre !== semFiltro) return false;
      if (depFiltro && d.departamento !== depFiltro) return false;
      if (grupoFiltro && !d.itens.some(i => i.grupo === grupoFiltro)) return false;
      if (busca) {
        const ok = d.itens.some(i =>
          (i.codigo||"").toLowerCase().includes(busca) ||
          (i.material||"").toLowerCase().includes(busca));
        if (!ok) return false;
      }
      return true;
    });

    renderKpis(filtradas);
    renderConsolidadoMaterial(filtradas, grupoFiltro, busca);
    renderConsolidadoSetor(filtradas);
    renderConsolidadoDepartamento(filtradas);
    renderConsolidadoGrupo(filtradas);
    renderDemandas(filtradas);
  }

  function normalizarDemanda(d) {
    if (d.itens) return d;
    const itens = (d.itens_demanda || d.itensDemanda || []).map(i => ({
      grupo: String(i.grupo || i.GRUPO || "").trim(),
      descGrupo: String(i.descGrupo || i["DESCRIÇÃO DO GRUPO"] || i.descricao_grupo || "").trim(),
      codigo: String(i.codigo || i["CÓDIGO_MATERIAL"] || i.codigo_material || "").trim(),
      material: String(i.material || i["MATERIAL"] || "").trim(),
      qtd: Number(i.qtd || i["QUANTIDADE_DEMANDADA_SEMESTRAL"] || 0),
      saldoBase: Number(i.saldoBase || i["SALDO_ESTOQUE_BASE"] || 0)
    }));
    return {
      id: d.id || d["ID_DEMANDA"] || "",
      dataHora: d.dataHora || d["DATA_HORA_ENVIO"] || "",
      semestre: d.semestre || d["SEMESTRE_DEMANDA"] || "",
      departamento: d.departamento || d["DEPARTAMENTO"] || "",
      setor: d.setor || d["SETOR_DEMANDANTE"] || "",
      responsavel: d.responsavel || d["RESPONSÁVEL_ADMINISTRATIVO_OU_TÉCNICO"] || "",
      chefia: d.chefia || d["CHEFIA_DO_SETOR"] || "",
      telefone: d.telefone || d["WHATSAPP_TELEFONE"] || "",
      email: d.email || d["EMAIL_SETOR_OU_RESPONSÁVEL"] || "",
      matricula: d.matricula || d["MATRÍCULA_RESPONSÁVEL"] || "",
      observacao: d.observacao || d["OBSERVAÇÃO"] || "",
      status: d.status || d["STATUS"] || "RECEBIDA",
      itens
    };
  }

  function renderKpis(demandas) {
    const todosItens = demandas.flatMap(d => d.itens);
    const totalDemandas = demandas.length;
    const setores = new Set(demandas.map(d => d.setor));
    const deps = new Set(demandas.map(d => d.departamento));
    const materiaisDistintos = new Set(todosItens.map(i => i.codigo));
    const totalQtd = todosItens.reduce((s,i) => s + i.qtd, 0);

    document.getElementById("adm-kpis").innerHTML = [
      ["Pedidos recebidos", totalDemandas, ""],
      ["Setores participantes", setores.size, ""],
      ["Departamentos participantes", deps.size, "de 8"],
      ["Materiais distintos", materiaisDistintos.size, ""],
      ["Quantidade total demandada", Util.fmtNum(totalQtd), "unidades"],
      ["Linhas de itens", todosItens.length, ""]
    ].map(([l,v,s]) => `
      <div class="kpi">
        <div class="kpi-label">${Util.esc(l)}</div>
        <div class="kpi-value">${v}</div>
        ${s ? `<div class="kpi-sub">${Util.esc(s)}</div>` : ""}
      </div>`).join("");
  }

  function renderConsolidadoMaterial(demandas, grupoFiltro, busca) {
    const map = new Map();
    demandas.flatMap(d => d.itens).forEach(i => {
      if (grupoFiltro && i.grupo !== grupoFiltro) return;
      if (busca && !(i.codigo||"").toLowerCase().includes(busca) && !(i.material||"").toLowerCase().includes(busca)) return;
      if (!map.has(i.codigo)) map.set(i.codigo, { ...i, demanda: 0 });
      map.get(i.codigo).demanda += i.qtd;
    });
    const linhas = [...map.values()].sort((a,b) => b.demanda - a.demanda);
    const tbody = document.querySelector("#adm-tabela-material tbody");
    if (!linhas.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="empty">Nenhum material demandado com os filtros atuais.</td></tr>';
      return;
    }
    tbody.innerHTML = linhas.map(i => {
      const saldoApos = i.saldoBase - i.demanda;
      const classeSaldo = saldoApos < 0 ? "vermelho" : "verde";
      return `<tr>
        <td class="mono">${Util.esc(i.codigo)}</td>
        <td>${Util.esc(i.material)}</td>
        <td>${Util.esc(i.descGrupo)}</td>
        <td class="num">${Util.fmtNum(i.saldoBase)}</td>
        <td class="num"><b>${Util.fmtNum(i.demanda)}</b></td>
        <td class="num"><span class="badge ${classeSaldo}">${Util.fmtNum(saldoApos)}</span></td>
      </tr>`;
    }).join("");
  }

  function renderConsolidadoSetor(demandas) {
    const map = new Map();
    demandas.forEach(d => {
      const k = d.departamento + "||" + d.setor;
      if (!map.has(k)) map.set(k, { departamento:d.departamento, setor:d.setor, linhas:0, total:0 });
      const o = map.get(k);
      o.linhas += d.itens.length;
      o.total += d.itens.reduce((s,i)=>s+i.qtd, 0);
    });
    const linhas = [...map.values()].sort((a,b)=>b.total-a.total);
    const tbody = document.querySelector("#adm-tabela-setor tbody");
    tbody.innerHTML = linhas.length
      ? linhas.map(r => `<tr>
          <td>${Util.esc(r.departamento)}</td>
          <td>${Util.esc(r.setor)}</td>
          <td class="num">${r.linhas}</td>
          <td class="num"><b>${Util.fmtNum(r.total)}</b></td>
        </tr>`).join("")
      : '<tr><td colspan="4" class="empty">Sem dados.</td></tr>';
  }

  function renderConsolidadoDepartamento(demandas) {
    const deps = API.getDepartamentos();
    const map = new Map(deps.map(d => [d, { linhas:0, total:0 }]));
    demandas.forEach(d => {
      if (!map.has(d.departamento)) map.set(d.departamento, { linhas:0, total:0 });
      const o = map.get(d.departamento);
      o.linhas += d.itens.length;
      o.total += d.itens.reduce((s,i)=>s+i.qtd, 0);
    });
    const tbody = document.querySelector("#adm-tabela-departamento tbody");
    tbody.innerHTML = [...map.entries()].map(([dep, o]) => `<tr>
      <td>${Util.esc(dep)}</td>
      <td class="num">${o.linhas}</td>
      <td class="num"><b>${Util.fmtNum(o.total)}</b></td>
    </tr>`).join("") + `<tr style="background:var(--azul-claro);font-weight:700">
      <td>TOTAL CT</td>
      <td class="num">${[...map.values()].reduce((s,o)=>s+o.linhas,0)}</td>
      <td class="num">${Util.fmtNum([...map.values()].reduce((s,o)=>s+o.total,0))}</td>
    </tr>`;
  }

  function renderConsolidadoGrupo(demandas) {
    const map = new Map();
    demandas.flatMap(d => d.itens).forEach(i => {
      if (!map.has(i.grupo)) map.set(i.grupo, { grupo:i.grupo, desc:i.descGrupo, materiais:new Set(), total:0 });
      const o = map.get(i.grupo);
      o.materiais.add(i.codigo);
      o.total += i.qtd;
    });
    const linhas = [...map.values()].sort((a,b)=>b.total-a.total);
    const tbody = document.querySelector("#adm-tabela-grupo tbody");
    tbody.innerHTML = linhas.length
      ? linhas.map(r => `<tr>
          <td class="mono">${Util.esc(r.grupo)}</td>
          <td>${Util.esc(r.desc)}</td>
          <td class="num">${r.materiais.size}</td>
          <td class="num"><b>${Util.fmtNum(r.total)}</b></td>
        </tr>`).join("")
      : '<tr><td colspan="4" class="empty">Sem dados.</td></tr>';
  }

  function renderDemandas(demandas) {
    const tbody = document.querySelector("#adm-tabela-demandas tbody");
    tbody.innerHTML = demandas.length
      ? demandas.map(d => {
          const total = d.itens.reduce((s,i)=>s+i.qtd,0);
          return `<tr>
            <td class="mono"><b>${Util.esc(d.id)}</b></td>
            <td>${Util.esc(d.dataHora)}</td>
            <td>${Util.esc(d.semestre)}</td>
            <td>${Util.esc(d.departamento)}</td>
            <td>${Util.esc(d.setor)}</td>
            <td class="num">${d.itens.length}</td>
            <td class="num"><b>${Util.fmtNum(total)}</b></td>
            <td><span class="badge">${Util.esc(d.status)}</span></td>
          </tr>`;
        }).join("")
      : '<tr><td colspan="8" class="empty">Nenhuma demanda registrada com os filtros atuais.</td></tr>';
  }

  function exportarCSV() {
    const tabela = document.querySelector("#adm-tabela-material");
    const linhas = [];
    tabela.querySelectorAll("tr").forEach(tr => {
      const cols = [...tr.querySelectorAll("th,td")].map(c => `"${c.textContent.trim().replace(/"/g,'""')}"`);
      linhas.push(cols.join(","));
    });
    const blob = new Blob(["\uFEFF" + linhas.join("\n")], { type:"text/csv;charset=utf-8" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `demanda_consolidada_${new Date().toISOString().slice(0,10)}.csv`;
    a.click();
    Util.toast("CSV exportado.", "ok");
  }

  async function diagnosticarAPI() {
    const el = document.getElementById("adm-diag");
    el.innerHTML = "⏳ Testando conexão com a API...";
    try {
      const url = API.ENDPOINT + (API.ENDPOINT.includes("?") ? "&" : "?") + "action=materiais";
      const r = await fetch(url, { redirect:"follow" });
      const text = await r.text();
      let json; try { json = JSON.parse(text); } catch(e) {}
      const qtd = json ? (Array.isArray(json) ? json.length : (json.materiais?.length || json.data?.length || 0)) : 0;
      el.innerHTML = `✅ API respondeu. HTTP ${r.status}. Materiais retornados: ${qtd}.<br><small>Endpoint: ${API.ENDPOINT}</small>`;
    } catch(e) {
      el.innerHTML = `❌ Falha na API: ${Util.esc(e.message)}.<br>Usando fallback local com ${window.__MATERIAIS_FALLBACK__.length} materiais.`;
    }
  }

  function populateFiltros() {
    const selSem = document.getElementById("adm-semestre");
    const selDep = document.getElementById("adm-departamento");
    const selGrp = document.getElementById("adm-grupo");

    if (!selSem.options.length || selSem.options.length <= 1) {
      Util.semestresDisponiveis().forEach(s => {
        const o = document.createElement("option"); o.value=s; o.textContent=s; selSem.appendChild(o);
      });
      API.getDepartamentos().forEach(d => {
        const o = document.createElement("option"); o.value=d; o.textContent=d; selDep.appendChild(o);
      });
      API.carregarMateriais().then(mats => {
        const grupos = [...new Map(mats.map(m=>[m.grupo,m])).values()].sort((a,b)=>a.grupo.localeCompare(b.grupo));
        grupos.forEach(g => {
          const o = document.createElement("option"); o.value=g.grupo;
          o.textContent = `${g.grupo} — ${g.descGrupo}`; selGrp.appendChild(o);
        });
      });
    }
  }

  return { render, exportarCSV, populateFiltros, diagnosticarAPI };
})();


/* ============================================================
   MÓDULO API — INTEGRAÇÃO PRESERVADA INTEGRALMENTE
   ============================================================ */
const API = (() => {
  const ENDPOINT = "https://script.google.com/macros/s/AKfycbzHquUmtGZqepBtwrarVSv9rIPrZhAunnZfZgEypdJ1X8IRQuzpp0QOV1LzJeYhvF71rQ/exec";

  const MATERIAIS_FALLBACK = window.__MATERIAIS_FALLBACK__ || [];

  const DEPARTAMENTOS = [
    "Direção do Centro de Tecnologia - CT",
    "Departamento de Arquitetura e Urbanismo - DAU",
    "Departamento de Engenharia de Alimentos - DEA",
    "Departamento de Engenharia de Materiais - DEMAT",
    "Departamento de Engenharia de Produção - DEP",
    "Departamento de Engenharia Civil e Ambiental - DECA",
    "Departamento de Engenharia Mecânica - DEM",
    "Departamento de Engenharia Química - DEQ"
  ];

  let _materiaisCache = null;
  let _fonte = "desconhecida";

  async function carregarMateriais() {
    if (_materiaisCache) return _materiaisCache;
    try {
      const url = ENDPOINT + (ENDPOINT.includes("?") ? "&" : "?") + "action=materiais";
      const resp = await fetch(url, { method: "GET", redirect: "follow" });
      if (!resp.ok) throw new Error("HTTP " + resp.status);
      const json = await resp.json();
      const lista = Array.isArray(json) ? json
                   : Array.isArray(json.materiais) ? json.materiais
                   : Array.isArray(json.data) ? json.data
                   : null;
      if (!lista || !lista.length) throw new Error("API retornou vazio");
      _materiaisCache = lista.map(normalizar).filter(m => m.codigo);
      _fonte = "api";
    } catch (e) {
      console.warn("[API] Falha ao consultar endpoint, usando fallback local:", e.message);
      _materiaisCache = MATERIAIS_FALLBACK.map(normalizar);
      _fonte = "fallback";
    }
    return _materiaisCache;
  }

  function normalizar(m) {
    return {
      grupo: String(m.grupo ?? m.GRUPO ?? m["GRUPO"] ?? "").trim(),
      descGrupo: String(m.descGrupo ?? m["DESCRIÇÃO DO GRUPO"] ?? m["DESCRICAO_DO_GRUPO"] ?? m.descricao_grupo ?? "").trim(),
      codigo: String(m.codigo ?? m["CÓDIGO"] ?? m["CODIGO"] ?? m.codigo_material ?? "").trim(),
      material: String(m.material ?? m["MATERIAL"] ?? m.descricao ?? "").trim(),
      saldo: Number(m.saldo ?? m["SALDO_ESTOQUE_ATUAL"] ?? m.saldo_estoque ?? 0) || 0
    };
  }

  function getDepartamentos() { return DEPARTAMENTOS.slice(); }
  function getFonte() { return _fonte; }

  async function enviarDemanda(payload) {
    try {
      const resp = await fetch(ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify(payload),
        redirect: "follow"
      });
      const text = await resp.text();
      let json;
      try { json = JSON.parse(text); } catch (e) { json = { ok: resp.ok }; }
      if (json && json.ok === false) throw new Error(json.erro || "Erro no backend");
      salvarLocal(payload);
      return { ok: true, id: json.id_demanda || payload.id_demanda, fonte: "api" };
    } catch (e) {
      console.warn("[API] Envio via rede falhou, registrando localmente:", e.message);
      salvarLocal(payload);
      return { ok: true, id: payload.id_demanda, fonte: "local" };
    }
  }

  function salvarLocal(payload) {
    try {
      const store = JSON.parse(localStorage.getItem("ct_demandas_local") || "[]");
      if (!store.find(d => d.id_demanda === payload.id_demanda)) {
        store.push(payload);
        localStorage.setItem("ct_demandas_local", JSON.stringify(store));
      }
    } catch(e) {}
  }

  async function buscarDemandas() {
    try {
      const url = ENDPOINT + (ENDPOINT.includes("?") ? "&" : "?") + "action=demandas";
      const r = await fetch(url, { redirect:"follow" });
      if (r.ok) {
        const j = await r.json();
        const lista = Array.isArray(j) ? j : j.demandas || j.data || [];
        if (lista.length) return lista;
      }
    } catch(e) {}
    return JSON.parse(localStorage.getItem("ct_demandas_local") || "[]");
  }

  return { carregarMateriais, getDepartamentos, getFonte, enviarDemanda, buscarDemandas, ENDPOINT };
})();


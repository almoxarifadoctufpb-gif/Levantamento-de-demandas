const App = (() => {

  const LOGIN_PADRAO = { user: "servidor ct", pass: "456789" };

  function autenticar() {
    const user = document.getElementById("login-user").value.trim().toLowerCase();
    const pass = document.getElementById("login-pass").value;
    const erro = document.getElementById("login-erro");
    if (user === LOGIN_PADRAO.user && pass === LOGIN_PADRAO.pass) {
      erro.style.display = "none";
      sessionStorage.setItem("ct_logado", "1");
      mostrarApp();
      return true;
    }
    erro.style.display = "block";
    return false;
  }

  function mostrarApp() {
    document.getElementById("login-screen").style.display = "none";
    document.getElementById("app-header").style.display = "";
    document.getElementById("app-main").style.display = "";
    App.init();
  }

  function logout() {
    const d = State.dados;
    const temConteudo = d.departamento || d.setor || d.responsavel || d.telefone || d.email || State.carrinho.length > 0;
    if (temConteudo && State.etapaAtual < 6) {
      Modal.confirmar(
        "Informações não salvas",
        "Você possui informações não salvas. Deseja gravar este pedido antes de sair?",
        () => {
          Rascunhos.salvar();
          _executarLogout();
        }
      );
      const btnCancelar = document.getElementById("modal-btn-cancelar");
      btnCancelar.textContent = "Sair sem salvar";
      btnCancelar.onclick = () => {
        Modal.fechar();
        _executarLogout();
      };
      return;
    }
    _executarLogout();
  }

  function _executarLogout() {
    const btnCancelar = document.getElementById("modal-btn-cancelar");
    btnCancelar.textContent = "Cancelar";
    btnCancelar.onclick = () => Modal.fechar();

    sessionStorage.removeItem("ct_logado");
    sessionStorage.removeItem("ct_orientacao_setor_vista");
    Rascunhos.limparEdicaoAtual();
    State.reset();
    document.getElementById("login-screen").style.display = "grid";
    document.getElementById("app-header").style.display = "none";
    document.getElementById("app-main").style.display = "none";
    document.getElementById("login-user").value = "";
    document.getElementById("login-pass").value = "";
    document.getElementById("login-erro").style.display = "none";
  }

  function go(view) {
    document.querySelectorAll(".view").forEach(v => v.classList.remove("active"));
    document.getElementById("view-" + view).classList.add("active");
    document.querySelectorAll(".topbar nav button").forEach(b => b.classList.remove("active"));
    const navBtn = document.getElementById("nav-" + view);
    if (navBtn) navBtn.classList.add("active");
    if (view === "admin") {
      Admin.populateFiltros();
      Admin.render();
    }
    if (view === "meuspedidos") {
      MeusPedidos.render();
    }
    window.scrollTo({ top:0, behavior:"smooth" });
  }

  function setEtapa(n) {
    State.etapaAtual = n;
    document.querySelectorAll(".etapa").forEach(e => e.style.display = "none");
    const alvo = document.getElementById("etapa-" + n);
    if (alvo) alvo.style.display = "block";
    document.querySelectorAll(".step").forEach(s => {
      const sn = Number(s.dataset.step);
      s.classList.toggle("active", sn === n);
      s.classList.toggle("done", sn < n);
    });
    const steps = document.querySelectorAll(".step");
    if (steps[n-1]) steps[n-1].scrollIntoView({ behavior:"smooth", block:"nearest" });
    window.scrollTo({ top:0, behavior:"smooth" });
  }

  function avancar(proxima) {
    if (State.etapaAtual === 2) Demanda.coletarDadosFormulario();
    if (State.etapaAtual === 3) Demanda.coletarDadosFormulario();
    const erros = Demanda.validarEtapa(proxima - 1);
    if (erros.length) { Util.toast(erros[0], "erro"); return; }
    if (proxima === 5) Demanda.renderRevisao();
    setEtapa(proxima);
    Rascunhos.autosave();
  }

  function voltar(anterior) {
    setEtapa(anterior);
    Rascunhos.autosave();
  }

  async function enviar() {
    Demanda.coletarDadosFormulario();
    const erros = Demanda.validarEtapa(5);
    if (erros.length) { Util.toast(erros[0], "erro"); return; }

    const d = State.dados;
    let seq = 1;
    try {
      const store = JSON.parse(localStorage.getItem("ct_demandas_local") || "[]");
      seq = store.length + 1;
    } catch(e) { seq = 1; }
    const id = Util.gerarIdDemanda(d.semestre, seq);

    const payload = {
      id_demanda: id,
      data_hora_envio: Util.agora(),
      semestre_demanda: d.semestre,
      departamento: d.departamento,
      setor_demandante: d.setor,
      responsavel_administrativo_ou_tecnico: d.responsavel,
      chefia_do_setor: d.chefia,
      whatsapp_telefone: d.telefone,
      email_setor_ou_responsavel: d.email,
      matricula_responsavel: d.matricula,
      observacao: d.observacao,
      status: "RECEBIDA",
      total_linhas_itens: State.carrinho.length,
      total_quantidade_demandada: State.totalUnidades(),
      itens: State.carrinho.map(i => ({
        grupo: i.grupo,
        descGrupo: i.descGrupo,
        codigo: i.codigo,
        material: i.material,
        qtd: i.qtd,
        saldoBase: i.saldo,
        saldoApos: i.saldo - i.qtd
      }))
    };

    const btn = document.querySelector("#etapa-5 .btn-success");
    if (btn) { btn.disabled = true; btn.innerHTML = '<svg class="ico-svg sm"><use href="#i-send"/></svg> Enviando...'; }
    const r = await API.enviarDemanda(payload);
    if (btn) { btn.disabled = false; btn.innerHTML = '<svg class="ico-svg sm"><use href="#i-send"/></svg> Confirmar e Enviar'; }

    if (State.rascunhoIdAtual) {
      try {
        const lista = Rascunhos.listar().filter(x => x.id !== State.rascunhoIdAtual);
        localStorage.setItem("ct_rascunhos_local", JSON.stringify(lista));
        Rascunhos.limparEdicaoAtual();
      } catch(e) {}
    }

    State.ultimaDemanda = payload;
    document.getElementById("sucesso-id").textContent = id;
    document.getElementById("sucesso-detalhes").innerHTML = `
      <div class="revisao-grid">
        <div class="revisao-item"><div class="k">Semestre</div><div class="v">${Util.esc(d.semestre)}</div></div>
        <div class="revisao-item"><div class="k">Departamento</div><div class="v">${Util.esc(d.departamento)}</div></div>
        <div class="revisao-item"><div class="k">Setor</div><div class="v">${Util.esc(d.setor)}</div></div>
        <div class="revisao-item"><div class="k">Itens</div><div class="v">${State.totalItens()} materiais</div></div>
        <div class="revisao-item"><div class="k">Total demandado</div><div class="v">${Util.fmtNum(State.totalUnidades())} unidades</div></div>
      </div>
      <div class="alert alert-info" style="margin-top:16px">
        <svg class="ico-svg md"><use href="#i-info"/></svg>
        <div>${r.fonte === "local"
          ? "A API não respondeu. A demanda foi registrada <b>localmente no navegador</b> e será reenviada automaticamente quando a conexão for restabelecida."
          : "Demanda registrada no banco de dados do Centro de Tecnologia."}</div>
      </div>`;
    setEtapa(6);
    Util.toast("Demanda registrada com sucesso!", "ok");
    MeusPedidos.render();
  }

  function novoPedido() {
    State.reset();
    Rascunhos.limparEdicaoAtual();
    document.querySelectorAll("input,select,textarea").forEach(el => {
      if (el.type === "checkbox") el.checked = false;
      else if (el.id && el.id.startsWith("adm-")) return;
      else if (el.id && el.id.startsWith("login-")) return;
      else el.value = "";
    });
    document.getElementById("lista-materiais").innerHTML = '<div class="empty"><svg class="ico-svg xxl"><use href="#i-clipboard"/></svg><div>Selecione um grupo acima para visualizar os materiais.</div></div>';
    Demanda.renderCarrinho();
    const hoje = new Date();
    const semAtual = `${hoje.getFullYear()}.${hoje.getMonth() < 6 ? 1 : 2}`;
    document.getElementById("sel-semestre").value = semAtual;
    State.dados.semestre = semAtual;
    setEtapa(1);
    go("demanda");
  }

  function imprimirComprovante() {
    Download.baixarPDF();
  }

  async function init() {
    await Demanda.init();
    Demanda.renderCarrinho();
    ["adm-semestre","adm-departamento","adm-grupo"].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.addEventListener("change", Admin.render);
    });
    const admBusca = document.getElementById("adm-busca");
    if (admBusca) admBusca.addEventListener("input", debounce(Admin.render, 250));
    console.info("[App] Aplicativo inicializado com melhorias visuais e funcionais.");
  }

  function debounce(fn, ms) {
    let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };
  }

  document.addEventListener("keydown", e => {
    if (e.key === "Enter" && document.getElementById("login-screen").style.display !== "none") {
      autenticar();
    }
  });
  document.getElementById("btn-login").addEventListener("click", autenticar);

  return { init, go, avancar, voltar, enviar, novoPedido, imprimirComprovante, logout, autenticar, mostrarApp, setEtapa };
})();

/* ============================================================
   BOOTSTRAP
   ============================================================ */
document.addEventListener("DOMContentLoaded", () => {
  if (sessionStorage.getItem("ct_logado") === "1") {
    App.mostrarApp();
  }
});
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Demanda Semestral de Materiais — CT/UFPB</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">

<style>
:root{
  --azul-ufpb:#0b3d6b;
  --azul-escuro:#062a4d;
  --azul-medio:#1565a8;
  --azul-claro:#e8f1f9;
  --azul-accent:#1a7bc4;
  --cinza-fundo:#f4f6f9;
  --cinza-borda:#dde3ea;
  --cinza-texto:#5a6577;
  --branco:#ffffff;
  --verde:#1e7d4a;
  --verde-claro:#e3f5ea;
  --vermelho:#c0392b;
  --vermelho-claro:#fde8e6;
  --amarelo-alerta:#fff8e1;
  --amarelo-borda:#f0a500;
  --sombra-xs:0 1px 2px rgba(11,61,107,.04);
  --sombra-sm:0 2px 6px rgba(11,61,107,.05);
  --sombra:0 6px 18px rgba(11,61,107,.07);
  --sombra-md:0 12px 32px rgba(11,61,107,.09);
  --sombra-lg:0 20px 48px rgba(11,61,107,.12);
  --raio:12px;
  --raio-sm:8px;
  --raio-xs:6px;
  --transicao:all .22s cubic-bezier(.4,0,.2,1);
  --transicao-rapida:all .15s cubic-bezier(.4,0,.2,1);
  --fonte: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:var(--fonte);
  background:var(--cinza-fundo);
  color:#1a2332;
  line-height:1.55;
  font-size:15px;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  font-feature-settings:"cv02","cv03","cv04","cv11";
}

/* ============================================================
   ÍCONES SVG
   ============================================================ */
.ico-svg{
  display:inline-flex;align-items:center;justify-content:center;
  flex-shrink:0;vertical-align:middle;
  stroke:currentColor;fill:none;
  stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;
}
.ico-svg.sm{width:16px;height:16px}
.ico-svg.md{width:18px;height:18px}
.ico-svg.lg{width:22px;height:22px}
.ico-svg.xl{width:28px;height:28px}
.ico-svg.xxl{width:38px;height:38px}
.ico-svg.brand{stroke-width:2}

/* ============================================================
   LOGIN
   ============================================================ */
#login-screen{
  position:fixed;inset:0;z-index:3000;
  background:linear-gradient(150deg,#0b3d6b 0%,#062a4d 100%);
  display:grid;place-items:center;padding:20px;
}
#login-screen::before{
  content:"";position:absolute;inset:0;
  background:radial-gradient(circle at 20% 30%,rgba(26,123,196,.25) 0%,transparent 45%),
             radial-gradient(circle at 85% 75%,rgba(26,123,196,.15) 0%,transparent 40%);
  pointer-events:none;
}
.login-card{
  position:relative;
  background:#fff;border-radius:20px;padding:40px 36px;max-width:430px;width:100%;
  box-shadow:0 30px 80px rgba(0,0,0,.35),0 0 0 1px rgba(255,255,255,.05);
  animation:fadeUp .5s cubic-bezier(.4,0,.2,1);
}

/* ===== LOGO OFICIAL — FUNDO ESCURO PARA A LOGO BRANCA ===== */
.login-card .logo-container{
  width:140px;height:140px;
  display:grid;place-items:center;
  margin:0 auto 22px;
  background:linear-gradient(135deg,var(--azul-ufpb),var(--azul-escuro));
  border-radius:18px;
  padding:18px;
  box-shadow:0 8px 24px rgba(11,61,107,.22);
}
.login-card .logo-login{
  width:100%;height:100%;
  display:block;
  object-fit:contain;
  background:transparent;
}

.login-card h1{
  font-size:21px;color:var(--azul-escuro);text-align:center;margin-bottom:6px;
  font-weight:700;letter-spacing:-.4px;line-height:1.3;
}
.login-card .sub{
  font-size:13px;color:var(--cinza-texto);text-align:center;margin-bottom:30px;
  font-weight:500;
}
.login-card .field{margin-bottom:18px}
.login-card .field label{
  display:block;font-size:12.5px;font-weight:600;color:var(--azul-escuro);
  margin-bottom:7px;letter-spacing:.1px;
}
.login-card .field input{
  width:100%;padding:13px 15px;border:1.5px solid var(--cinza-borda);border-radius:var(--raio-sm);
  font-size:14px;font-family:inherit;transition:var(--transicao);background:#fafbfc;
  color:#1a2332;
}
.login-card .field input:focus{
  outline:none;border-color:var(--azul-medio);background:#fff;
  box-shadow:0 0 0 4px rgba(21,101,168,.1);
}
.login-card .btn-login{
  width:100%;padding:14px;background:linear-gradient(135deg,var(--azul-ufpb),var(--azul-medio));
  color:#fff;border:none;border-radius:var(--raio-sm);font-size:15px;font-weight:600;
  cursor:pointer;font-family:inherit;transition:var(--transicao);margin-top:10px;
  box-shadow:0 6px 16px rgba(11,61,107,.25);
  display:flex;align-items:center;justify-content:center;gap:9px;
  letter-spacing:.1px;
}
.login-card .btn-login:hover{
  transform:translateY(-1.5px);
  box-shadow:0 10px 24px rgba(11,61,107,.35);
}
.login-card .btn-login:active{transform:translateY(0)}
.login-card .erro-login{
  background:var(--vermelho-claro);color:var(--vermelho);border-left:3px solid var(--vermelho);
  padding:11px 15px;border-radius:var(--raio-xs);font-size:13px;margin-bottom:16px;display:none;
  font-weight:500;
}

/* ============================================================
   HEADER
   ============================================================ */
header.topbar{
  background:linear-gradient(135deg,var(--azul-ufpb),var(--azul-escuro));
  color:#fff;padding:14px 24px;position:sticky;top:0;z-index:100;
  box-shadow:0 2px 20px rgba(0,0,0,.15);
  border-bottom:1px solid rgba(255,255,255,.08);
}
.topbar-inner{max-width:1240px;margin:0 auto;display:flex;align-items:center;gap:16px;flex-wrap:wrap}

/* ===== LOGO OFICIAL NO HEADER — FUNDO ESCURO PARA LOGO BRANCA ===== */
.logo-badge{
  width:54px;height:54px;border-radius:11px;
  background:rgba(255,255,255,.06);
  display:grid;place-items:center;overflow:hidden;flex-shrink:0;
  border:1px solid rgba(255,255,255,.12);
  padding:6px;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.06);
}
.logo-badge img{
  width:100%;height:100%;object-fit:contain;
  background:transparent;
}

.topbar h1{font-size:15px;font-weight:600;line-height:1.25;letter-spacing:-.25px}
.topbar p{font-size:11.5px;opacity:.78;margin-top:2px;font-weight:400;letter-spacing:.1px}
.topbar nav{margin-left:auto;display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.topbar nav button{
  background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);
  color:#fff;padding:9px 15px;border-radius:var(--raio-xs);cursor:pointer;
  font-size:13px;font-weight:500;transition:var(--transicao);font-family:inherit;
  display:inline-flex;align-items:center;gap:7px;letter-spacing:.1px;
}
.topbar nav button:hover{background:rgba(255,255,255,.16);border-color:rgba(255,255,255,.28);transform:translateY(-1px)}
.topbar nav button:active{transform:translateY(0)}
.topbar nav button.active{background:#fff;color:var(--azul-ufpb);border-color:#fff;font-weight:600;box-shadow:0 2px 10px rgba(0,0,0,.15)}
.topbar .btn-logout{
  background:rgba(255,255,255,.04)!important;border-color:rgba(255,255,255,.12)!important;
  font-size:12px!important;padding:8px 13px!important;
}
.topbar .btn-logout:hover{background:rgba(220,80,80,.18)!important;border-color:rgba(255,255,255,.25)!important}

main{max-width:1240px;margin:0 auto;padding:28px 18px 90px}
.view{display:none;animation:fadeUp .35s cubic-bezier(.4,0,.2,1)}
.view.active{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@keyframes fade{from{opacity:0}to{opacity:1}}
@keyframes pop{0%{transform:scale(0)}70%{transform:scale(1.08)}100%{transform:scale(1)}}
@keyframes spin{to{transform:rotate(360deg)}}

/* ============================================================
   STEPPER
   ============================================================ */
.stepper{display:flex;gap:8px;margin-bottom:26px;overflow-x:auto;padding-bottom:8px;scrollbar-width:thin}
.stepper::-webkit-scrollbar{height:5px}
.stepper::-webkit-scrollbar-thumb{background:var(--cinza-borda);border-radius:10px}
.step{
  flex:1;min-width:124px;background:#fff;border:1.5px solid var(--cinza-borda);
  border-radius:var(--raio);padding:11px 15px;font-size:12px;color:var(--cinza-texto);
  display:flex;align-items:center;gap:10px;transition:var(--transicao);
  box-shadow:var(--sombra-xs);font-weight:500;
}
.step .num{
  width:27px;height:27px;border-radius:50%;background:var(--cinza-fundo);
  color:var(--cinza-texto);display:grid;place-items:center;font-weight:700;
  font-size:12px;flex-shrink:0;transition:var(--transicao);
  border:1.5px solid transparent;
}
.step.active{
  border-color:var(--azul-medio);background:var(--azul-claro);
  box-shadow:0 4px 14px rgba(21,101,168,.14);color:var(--azul-ufpb);font-weight:600;
}
.step.active .num{background:var(--azul-ufpb);color:#fff;border-color:var(--azul-ufpb)}
.step.done .num{background:var(--verde);color:#fff;border-color:var(--verde)}
.step.done{border-color:var(--verde-claro);color:var(--verde)}

/* ============================================================
   CARDS
   ============================================================ */
.card{
  background:#fff;border:1px solid var(--cinza-borda);border-radius:var(--raio);
  padding:28px;margin-bottom:20px;box-shadow:var(--sombra-sm);
  transition:var(--transicao);
}
.card:hover{box-shadow:var(--sombra)}
.card h2{
  font-size:17.5px;color:var(--azul-escuro);margin-bottom:6px;
  display:flex;align-items:center;gap:10px;font-weight:700;letter-spacing:-.3px;
}
.card h2 .ico-svg{color:var(--azul-medio)}
.card .sub{font-size:13px;color:var(--cinza-texto);margin-bottom:20px;line-height:1.5}

.banner-semestre{
  background:linear-gradient(135deg,#fff9e6,#fff3c4);
  border-left:4px solid var(--amarelo-borda);border-radius:var(--raio);
  padding:18px 22px;margin-bottom:24px;box-shadow:var(--sombra-xs);
  display:flex;gap:14px;align-items:flex-start;
}
.banner-semestre .ico-svg{color:#7a5200;flex-shrink:0;margin-top:2px}
.banner-semestre h3{color:#7a5200;font-size:14px;margin-bottom:5px;font-weight:700;letter-spacing:.1px}
.banner-semestre p{color:#8a6500;font-size:13px;line-height:1.55}

/* ============================================================
   FORMULÁRIO
   ============================================================ */
.grid{display:grid;gap:18px}
.grid.two{grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
.field label{
  display:block;font-size:13px;font-weight:600;color:var(--azul-escuro);
  margin-bottom:7px;letter-spacing:.1px;
}
.field label .req{color:var(--vermelho);margin-left:1px}
.field input,.field select,.field textarea{
  width:100%;padding:12px 15px;border:1.5px solid var(--cinza-borda);
  border-radius:var(--raio-sm);font-size:14px;font-family:inherit;background:#fafbfc;
  transition:var(--transicao);color:#1a2332;
}
.field input:hover,.field select:hover,.field textarea:hover{border-color:#c5cdd6}
.field input:focus,.field select:focus,.field textarea:focus{
  outline:none;border-color:var(--azul-medio);background:#fff;
  box-shadow:0 0 0 4px rgba(21,101,168,.1);
}
.field input:disabled,.field select:disabled{background:#f4f6f9;color:#9aa5b1;cursor:not-allowed}
.field textarea{resize:vertical;min-height:88px;line-height:1.5}
.field .hint{font-size:11.5px;color:#9aa5b1;margin-top:6px;line-height:1.45;display:flex;gap:5px;align-items:flex-start}
.field.error input,.field.error select{border-color:var(--vermelho);background:#fef2f2}
#inp-setor-manual{background:#fffdf5;border-color:#f0c674}
#inp-setor-manual:focus{border-color:#e08e00;box-shadow:0 0 0 4px rgba(240,165,0,.14)}

/* ============================================================
   BOTÕES
   ============================================================ */
.btn{
  padding:12px 22px;border-radius:var(--raio-sm);border:none;font-size:14px;
  font-weight:600;cursor:pointer;font-family:inherit;transition:var(--transicao);
  display:inline-flex;align-items:center;gap:8px;letter-spacing:.1px;
  white-space:nowrap;justify-content:center;
}
.btn-primary{
  background:linear-gradient(135deg,var(--azul-ufpb),var(--azul-medio));color:#fff;
  box-shadow:0 3px 10px rgba(11,61,107,.22);
}
.btn-primary:hover:not(:disabled){transform:translateY(-1.5px);box-shadow:0 6px 18px rgba(11,61,107,.32)}
.btn-success{
  background:linear-gradient(135deg,var(--verde),#166139);color:#fff;
  box-shadow:0 3px 10px rgba(30,125,74,.22);
}
.btn-success:hover:not(:disabled){transform:translateY(-1.5px);box-shadow:0 6px 18px rgba(30,125,74,.32)}
.btn-outline{background:#fff;border:1.5px solid var(--cinza-borda);color:var(--azul-escuro)}
.btn-outline:hover{background:var(--azul-claro);border-color:var(--azul-medio);transform:translateY(-1px)}
.btn-danger{background:#fff;border:1.5px solid #f0c4c0;color:var(--vermelho)}
.btn-danger:hover{background:var(--vermelho-claro);transform:translateY(-1px)}
.btn:disabled{opacity:.55;cursor:not-allowed;transform:none!important;box-shadow:none!important}
.btn:active:not(:disabled){transform:translateY(0)!important}
.btn-sm{padding:8px 14px;font-size:12.5px;border-radius:var(--raio-xs);gap:6px}
.btn-ghost{background:transparent;border:none;color:var(--azul-medio);padding:9px 13px}
.btn-ghost:hover{background:var(--azul-claro)}
.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px;justify-content:flex-end}

.btn-download{
  background:#fff;border:1.5px solid var(--cinza-borda);
  color:var(--azul-escuro);padding:13px 24px;font-size:14px;
  box-shadow:var(--sombra-xs);
}
.btn-download:hover{
  background:var(--azul-claro);border-color:var(--azul-medio);
  transform:translateY(-1.5px);box-shadow:var(--sombra-sm);
}
.btn-download.pdf .ico-svg{color:#c0392b}
.btn-download.xlsx .ico-svg{color:#1e7d4a}

/* ============================================================
   TABELA
   ============================================================ */
.table-wrap{overflow-x:auto;border:1px solid var(--cinza-borda);border-radius:var(--raio);background:#fff;box-shadow:var(--sombra-xs)}
table{width:100%;border-collapse:collapse;font-size:13px;background:#fff}
th{
  background:var(--azul-claro);color:var(--azul-escuro);text-align:left;
  padding:12px 15px;font-weight:600;font-size:12px;white-space:nowrap;
  border-bottom:1.5px solid var(--cinza-borda);letter-spacing:.2px;
}
td{padding:11px 15px;border-bottom:1px solid #f0f3f7;vertical-align:middle}
tr:last-child td{border-bottom:none}
tbody tr{transition:background .15s ease}
tbody tr:hover td{background:#fafbfc}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
td.mono{font-family:var(--mono);font-size:12px;color:var(--cinza-texto)}

.badge{
  display:inline-flex;align-items:center;gap:4px;padding:3px 11px;border-radius:20px;font-size:11px;
  font-weight:600;background:var(--azul-claro);color:var(--azul-ufpb);letter-spacing:.2px;
}
.badge.verde{background:var(--verde-claro);color:var(--verde)}
.badge.vermelho{background:var(--vermelho-claro);color:var(--vermelho)}
.badge.amarelo{background:#fff3c4;color:#7a5200}
.badge.cinza{background:#eef1f5;color:var(--cinza-texto)}

/* ============================================================
   MATERIAIS
   ============================================================ */
.material-row{
  display:grid;grid-template-columns:1fr auto;gap:16px;
  padding:15px;border:1px solid var(--cinza-borda);border-radius:var(--raio);
  background:#fff;margin-bottom:9px;align-items:center;transition:var(--transicao);
}
.material-row:hover{border-color:var(--azul-medio);box-shadow:var(--sombra-sm);transform:translateY(-1px)}
.material-info{min-width:0}
.material-info .nome{
  font-size:13px;font-weight:600;color:#1a2332;margin-bottom:4px;
  overflow:hidden;text-overflow:ellipsis;display:-webkit-box;
  -webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.4;
}
.material-info .meta{font-size:11.5px;color:var(--cinza-texto)}
.material-info .meta b{color:var(--azul-ufpb)}
.material-add{display:flex;gap:8px;align-items:center;flex-shrink:0}
.material-add input{
  width:76px;padding:10px;border:1.5px solid var(--cinza-borda);border-radius:var(--raio-sm);
  text-align:center;font-size:14px;font-family:inherit;transition:var(--transicao);font-weight:600;
}
.material-add input:focus{outline:none;border-color:var(--azul-medio);box-shadow:0 0 0 3px rgba(21,101,168,.12)}

/* ============================================================
   CARRINHO
   ============================================================ */
.cart-item{
  display:grid;grid-template-columns:1fr 96px auto;gap:14px;align-items:center;
  padding:13px 15px;border-bottom:1px solid #f0f3f7;
  transition:background .15s ease;
}
.cart-item:hover{background:#fafbfc}
.cart-item:last-child{border-bottom:none}
.cart-item .ci-nome{font-size:13px;font-weight:500;line-height:1.45}
.cart-item .ci-meta{font-size:11.5px;color:var(--cinza-texto);margin-top:3px}
.cart-item input{
  width:100%;padding:9px;border:1.5px solid var(--cinza-borda);border-radius:var(--raio-sm);
  text-align:center;font-size:14px;font-family:inherit;transition:var(--transicao);font-weight:600;
}
.cart-item input:focus{outline:none;border-color:var(--azul-medio);box-shadow:0 0 0 3px rgba(21,101,168,.12)}
.cart-item .btn-remove{
  background:none;border:none;color:var(--vermelho);cursor:pointer;
  font-size:15px;padding:7px 11px;border-radius:var(--raio-sm);transition:var(--transicao);
  display:inline-flex;align-items:center;justify-content:center;
}
.cart-item .btn-remove:hover{background:var(--vermelho-claro)}
.cart-total{
  display:flex;justify-content:space-between;padding:15px 18px;
  background:var(--azul-claro);border-radius:var(--raio);margin-top:14px;
  font-weight:600;color:var(--azul-escuro);font-size:13.5px;
  border:1px solid rgba(21,101,168,.1);
}

/* ============================================================
   REVISÃO
   ============================================================ */
.revisao-bloco{margin-bottom:24px}
.revisao-bloco h3{
  font-size:12px;color:var(--azul-ufpb);text-transform:uppercase;
  letter-spacing:.7px;margin-bottom:12px;padding-bottom:8px;
  border-bottom:1.5px solid var(--cinza-borda);font-weight:700;
  display:flex;align-items:center;gap:8px;
}
.revisao-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
.revisao-item{font-size:13px}
.revisao-item .k{color:var(--cinza-texto);font-size:11px;text-transform:uppercase;letter-spacing:.4px;font-weight:600;margin-bottom:3px}
.revisao-item .v{color:#1a2332;font-weight:500;line-height:1.45}

/* ============================================================
   KPIs
   ============================================================ */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:16px;margin-bottom:24px}
.kpi{
  background:#fff;border:1px solid var(--cinza-borda);border-radius:var(--raio);
  padding:20px;box-shadow:var(--sombra-sm);transition:var(--transicao);
  position:relative;overflow:hidden;
}
.kpi::before{
  content:"";position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,var(--azul-ufpb),var(--azul-accent));
  opacity:0;transition:opacity .2s ease;
}
.kpi:hover{box-shadow:var(--sombra);transform:translateY(-2px);border-color:#c5d3e0}
.kpi:hover::before{opacity:1}
.kpi .kpi-label{font-size:11px;color:var(--cinza-texto);text-transform:uppercase;letter-spacing:.6px;font-weight:700}
.kpi .kpi-value{font-size:30px;font-weight:700;color:var(--azul-ufpb);margin-top:10px;line-height:1;letter-spacing:-.8px}
.kpi .kpi-sub{font-size:11px;color:var(--cinza-texto);margin-top:6px;font-weight:500}

/* ============================================================
   FILTROS
   ============================================================ */
.filtros{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:18px}
.filtros select,.filtros input{
  padding:11px 14px;border:1.5px solid var(--cinza-borda);border-radius:var(--raio-sm);
  font-size:13px;font-family:inherit;background:#fafbfc;width:100%;transition:var(--transicao);
  color:#1a2332;
}
.filtros select:focus,.filtros input:focus{
  outline:none;border-color:var(--azul-medio);background:#fff;
  box-shadow:0 0 0 3px rgba(21,101,168,.1);
}

/* ============================================================
   SUCESSO
   ============================================================ */
.sucesso-box{text-align:center;padding:48px 28px}
.sucesso-box .check{
  width:84px;height:84px;border-radius:50%;
  background:linear-gradient(135deg,var(--verde-claro),#c8ecd8);
  color:var(--verde);
  display:grid;place-items:center;margin:0 auto 24px;
  animation:pop .45s cubic-bezier(.4,0,.2,1);
  box-shadow:0 8px 24px rgba(30,125,74,.15);
  border:2px solid rgba(30,125,74,.12);
}
.sucesso-box h2{color:var(--verde);font-size:23px;margin-bottom:10px;justify-content:center;font-weight:700;letter-spacing:-.4px}
.sucesso-box .sub{color:var(--cinza-texto);font-size:14px;margin-bottom:8px}
.sucesso-box .id-demanda{
  font-family:var(--mono);font-size:22px;font-weight:700;
  color:var(--azul-ufpb);background:var(--azul-claro);padding:14px 28px;
  border-radius:var(--raio);display:inline-block;margin:16px 0 6px;
  letter-spacing:1.5px;border:1.5px dashed var(--azul-medio);
}
.sucesso-acoes{
  display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:28px;
}

/* ============================================================
   TOAST
   ============================================================ */
.toast{
  position:fixed;bottom:30px;left:50%;transform:translateX(-50%) translateY(120px);
  background:var(--azul-escuro);color:#fff;padding:14px 22px;border-radius:var(--raio);
  font-size:13.5px;font-weight:500;box-shadow:0 12px 36px rgba(0,0,0,.28);
  z-index:2000;opacity:0;transition:.38s cubic-bezier(.4,0,.2,1);pointer-events:none;
  max-width:min(90vw,520px);border-left:4px solid var(--azul-medio);
  display:flex;align-items:center;gap:10px;line-height:1.45;
}
.toast.show{transform:translateX(-50%) translateY(0);opacity:1}
.toast.erro{background:var(--vermelho);border-left-color:#ff8a80}
.toast.ok{background:var(--verde);border-left-color:#69f0ae}

/* ============================================================
   ALERTAS
   ============================================================ */
.alert{
  padding:15px 18px;border-radius:var(--raio-sm);font-size:13px;margin-bottom:18px;
  display:flex;gap:12px;align-items:flex-start;line-height:1.55;
  border:1px solid transparent;
}
.alert .ico-svg{flex-shrink:0;margin-top:1px}
.alert-info{background:var(--azul-claro);color:var(--azul-ufpb);border-left:3px solid var(--azul-medio);border-color:rgba(21,101,168,.12)}
.alert-warn{background:var(--amarelo-alerta);color:#7a5200;border-left:3px solid var(--amarelo-borda);border-color:rgba(240,165,0,.18)}
.alert-erro{background:var(--vermelho-claro);color:var(--vermelho);border-left:3px solid var(--vermelho);border-color:rgba(192,57,43,.12)}

/* ============================================================
   EMPTY / LOADING
   ============================================================ */
.empty{text-align:center;padding:40px 18px;color:var(--cinza-texto);font-size:13.5px}
.empty .ico-svg{opacity:.35;margin-bottom:12px;color:var(--azul-medio)}
.loading{text-align:center;padding:52px;color:var(--cinza-texto)}
.spinner{
  width:42px;height:42px;border:3px solid var(--azul-claro);
  border-top-color:var(--azul-ufpb);border-radius:50%;
  animation:spin .8s linear infinite;margin:0 auto 16px;
}
.admin-badge{
  background:var(--amarelo-alerta);color:#7a5200;padding:3px 11px;
  border-radius:5px;font-size:10px;font-weight:800;margin-left:8px;letter-spacing:.6px;
  border:1px solid rgba(240,165,0,.2);
}

/* ============================================================
   MEUS PEDIDOS
   ============================================================ */
.pedidos-lista{display:flex;flex-direction:column;gap:14px}
.pedido-card{
  display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center;
  padding:18px 20px;border:1.5px solid var(--cinza-borda);border-radius:var(--raio);
  background:#fff;transition:var(--transicao);box-shadow:var(--sombra-xs);
}
.pedido-card:hover{border-color:var(--azul-medio);box-shadow:var(--sombra);transform:translateY(-1px)}
.pedido-card .pc-top{display:flex;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap}
.pedido-card .pc-id{
  font-family:var(--mono);font-weight:700;font-size:14px;color:var(--azul-ufpb);
  letter-spacing:.5px;
}
.pedido-card .pc-titulo{font-size:14.5px;font-weight:600;color:#1a2332;margin-bottom:5px}
.pedido-card .pc-meta{font-size:12.5px;color:var(--cinza-texto);line-height:1.65}
.pedido-card .pc-meta b{color:var(--azul-ufpb)}
.pedido-card .pc-actions{display:flex;gap:9px;flex-shrink:0;flex-wrap:wrap;justify-content:flex-end}
@media(max-width:680px){
  .pedido-card{grid-template-columns:1fr}
  .pedido-card .pc-actions{justify-content:flex-start}
}

.tabs{
  display:flex;gap:4px;margin-bottom:22px;border-bottom:2px solid var(--cinza-borda);
  padding-bottom:0;overflow-x:auto;
}
.tab{
  padding:13px 22px;border:none;background:none;cursor:pointer;font-family:inherit;
  font-size:14px;font-weight:600;color:var(--cinza-texto);transition:var(--transicao);
  border-bottom:3px solid transparent;margin-bottom:-2px;white-space:nowrap;
  display:inline-flex;align-items:center;gap:7px;
}
.tab:hover{color:var(--azul-ufpb)}
.tab.active{color:var(--azul-ufpb);border-bottom-color:var(--azul-ufpb)}
.tab .count{
  display:inline-block;background:var(--azul-claro);color:var(--azul-ufpb);
  padding:1px 9px;border-radius:11px;font-size:11px;margin-left:2px;font-weight:700;
}
.tab.active .count{background:var(--azul-ufpb);color:#fff}

/* ============================================================
   MODAL
   ============================================================ */
.modal-overlay{
  position:fixed;inset:0;background:rgba(6,42,77,.5);backdrop-filter:blur(5px);
  -webkit-backdrop-filter:blur(5px);
  z-index:4000;display:none;place-items:center;padding:20px;animation:fade .22s ease;
}
.modal-overlay.show{display:grid}
.modal-box{
  background:#fff;border-radius:16px;padding:30px;max-width:460px;width:100%;
  box-shadow:0 28px 72px rgba(0,0,0,.32);animation:pop .28s cubic-bezier(.4,0,.2,1);
  border:1px solid rgba(255,255,255,.1);
}
.modal-box h3{font-size:17.5px;color:var(--azul-escuro);margin-bottom:12px;font-weight:700;letter-spacing:-.2px}
.modal-box p{font-size:14px;color:var(--cinza-texto);margin-bottom:24px;line-height:1.6}
.modal-box .modal-actions{display:flex;gap:11px;justify-content:flex-end;flex-wrap:wrap}
@media(max-width:640px){
  .modal-box .modal-actions{flex-direction:column-reverse}
  .modal-box .modal-actions .btn{width:100%;justify-content:center}
}

/* ============================================================
   MODAL DE ORIENTAÇÃO DO SETOR
   ============================================================ */
.modal-orientacao .modal-box{
  max-width:500px;
  border-top:4px solid var(--amarelo-borda);
}
.modal-orientacao h3{
  display:flex;align-items:center;gap:10px;font-size:18px;
  color:var(--azul-escuro);margin-bottom:18px;
}
.modal-orientacao .orientacao-corpo{
  font-size:14px;color:#1a2332;line-height:1.7;
}
.modal-orientacao .orientacao-corpo p{margin-bottom:14px}
.modal-orientacao .orientacao-corpo .destaque{
  background:#fff8e1;border-left:3px solid var(--amarelo-borda);
  padding:12px 16px;border-radius:var(--raio-xs);margin:16px 0;font-size:13.5px;
}
.modal-orientacao .orientacao-corpo .exemplo{
  background:var(--azul-claro);border-left:3px solid var(--azul-medio);
  padding:12px 16px;border-radius:var(--raio-xs);margin:16px 0;font-size:13.5px;
  color:var(--azul-ufpb);
}
.modal-orientacao .orientacao-corpo .exemplo b{color:var(--azul-escuro)}

/* ============================================================
   INDICADORES
   ============================================================ */
.salvo-indicator{
  display:inline-flex;align-items:center;gap:7px;font-size:12.5px;color:var(--verde);
  font-weight:600;opacity:0;transition:opacity .3s, transform .3s;padding:7px 14px;
  background:var(--verde-claro);border-radius:22px;border:1px solid rgba(30,125,74,.12);
  transform:translateY(-4px);pointer-events:none;
}
.salvo-indicator.show{opacity:1;transform:translateY(0)}

.etapa-badge{
  display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;
  padding:4px 11px;border-radius:14px;background:var(--azul-claro);color:var(--azul-ufpb);
  letter-spacing:.3px;text-transform:uppercase;
}
.etapa-badge.rascunho{background:#fff3c4;color:#7a5200}
.etapa-badge.enviado{background:var(--verde-claro);color:var(--verde)}

/* ============================================================
   RESPONSIVIDADE
   ============================================================ */
@media(max-width:720px){
  main{padding:20px 14px 80px}
  .card{padding:20px}
  .card h2{font-size:16px}
  .stepper{gap:6px;margin-bottom:20px}
  .step{min-width:108px;font-size:11.5px;padding:9px 12px}
  .step .num{width:24px;height:24px;font-size:11px}
  .kpi .kpi-value{font-size:24px}
  .material-row{grid-template-columns:1fr;gap:10px}
  .material-add{justify-content:flex-end}
  .cart-item{grid-template-columns:1fr 76px auto;gap:10px;padding:11px 12px}
  .actions{flex-direction:column-reverse;gap:10px}
  .actions .btn{width:100%;justify-content:center}
  .sucesso-box{padding:32px 16px}
  .sucesso-box .id-demanda{font-size:18px;padding:12px 18px;letter-spacing:1px}
  .sucesso-acoes .btn{width:100%;justify-content:center}
  .login-card{padding:30px 24px}
  /* Ajuste responsivo do container da logo de login */
  .login-card .logo-container{width:118px;height:118px;padding:15px;margin-bottom:18px}
  .topbar-inner{gap:12px}
  .topbar h1{font-size:13.5px}
  .topbar p{font-size:10.5px}
  .topbar nav{width:100%;margin-left:0}
  .topbar nav button{flex:1;font-size:11.5px;padding:9px 8px;min-width:0;justify-content:center}
  .topbar nav button .ico-svg{display:none}
  .topbar .btn-logout{flex:0 0 auto;padding:9px 14px!important}
  .topbar .btn-logout .ico-svg{display:inline-flex}
  .pedido-card{padding:15px}
  .modal-box{padding:24px 20px}
  .modal-orientacao .modal-box{padding:22px 18px}
  /* Ajuste responsivo da logo do header */
  .logo-badge{width:46px;height:46px;padding:5px}
}

@media(max-width:420px){
  .topbar nav button span{display:none}
  .topbar nav button{padding:10px 12px}
  .topbar nav button .ico-svg{display:inline-flex}
}

/* ============================================================
   PRINT
   ============================================================ */
@media print{
  header.topbar, .stepper, .actions, .no-print, .topbar nav, .sucesso-acoes{display:none!important}
  body{background:#fff}
  .card{border:none;box-shadow:none;padding:0;margin-bottom:16px}
  main{padding:0;max-width:100%}
  .view{display:none!important}
  .view.print-target{display:block!important}
}
